# Orbital deployment environment
#
# Copy this file to .env, fill the values locally, and never commit .env.
# Use a dedicated testnet key with no real funds or production permissions.

# JSON-RPC endpoint for the chosen testnet. Required by `forge script --rpc-url`.
RPC_URL=

# Hex private key used only by contracts/script/DeployOrbitalHook.s.sol.
# The deploy script reads this from the environment; do not put it in source files.
PRIVATE_KEY=

# Existing v4 PoolManager address on the target network.
POOL_MANAGER=

# Four already-deployed mock token addresses. They must be strictly ascending by
# address because the deployment script validates the Currency ordering.
USDC=
USDT=
DAI=
FRAX=

# Informational deployment metadata. These are not read by the Solidity script
# and should be filled only after independently verifying a broadcast.
CHAIN_ID=1301
ORBITAL_HOOK_ADDRESS=
RANGE_SHARE_BOOK_ADDRESS=
SWAP_ROUTER_ADDRESS=
POSITION_MANAGER_ADDRESS=
DEPLOYMENT_TX_HASH=
