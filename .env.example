# Orbital deployment environment
#
# Copy this file to .env, fill the values locally, and never commit .env.
# Use a dedicated testnet key with no real funds or production permissions.

# JSON-RPC endpoint for the target network. Public Unichain Sepolia endpoint shown.
RPC_URL=https://sepolia.unichain.org

# Hex private key read by the deployment scripts (environment only, never source).
PRIVATE_KEY=

# Uniswap v4 PoolManager on Unichain Sepolia (chain 1301), from the official
# v4 deployments page. Set to 0x000...000 on a local anvil node to deploy a fresh
# PoolManager inside DeployOrbitalDemo.
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac

# Optional: JSON output written by DeployOrbitalDemo (must live under contracts/deployments).
DEPLOYMENT_OUT=./deployments/unichain-sepolia.json

# Only for DeployOrbitalHook.s.sol (hook against already-deployed tokens, any order).
USDC=
USDT=
DAI=
FRAX=
